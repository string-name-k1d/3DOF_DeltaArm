<?xml version="1.0"?>
<!--
  Gazebo (Classic) delta-arm world, generated from xacro.

  This descriptor is the 3-D counterpart of the 2-D SFML simulator and uses
  the SAME mechanism geometry and maths as the 2-D FK/IK in
  arm/src/axis/delta-arm.cpp (values taken from the shared "geometry"
  parameters in config/arm_params.yaml, converted to metres):

      pivot_radius    t  =  45 mm   shoulder pivot lines (actuation joints)
      upper_arm_len  rf = 160 mm   upper arm  (revolute, actuated)
      rod_len        re = 320 mm   lower rod  (ball joint at BOTH ends)
      ee_radius      pr =  60 mm   platform circumradius (apex-down, hanging

  each platform joint sits on the SAME radial as its actuation joint):

      arm joints: (0,-45,0)  (38.97,22.5,0)  (-38.97,22.5,0)
      platform joints:      (0,-60,0) (51.96,30,0) (-51.96,30,0)

  Servos are mounted UNDER the base plate at servo_radius = 150 mm, matching
  the visualiser's servo+parallelogram interlinkage (servo_z < 0). The motor
  boxes at radius t mark the actuation joints the plugin actually servoes.

  Closed kinematic loops: each leg ends in a BALL joint into the shared
  platform link (SDF ball joints - impossible in plain URDF). The
  delta_arm_gazebo_plugin subscribes to arm/motor_targets (degrees) and
  servoes the three shoulder joints.
-->
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PARAMETERS ==================== -->
  <xacro:property name="pivot_radius"        value="0.045" /> <!-- t:  joint radius, mm/1000 -->
  <xacro:property name="upper_arm_len"       value="0.160" /> <!-- rf: upper arm length -->
  <xacro:property name="rod_len"             value="0.320" /> <!-- re: lower rod length -->
  <xacro:property name="ee_radius"           value="0.060" /> <!-- pr: platform radius -->
  <xacro:property name="servo_radius"        value="0.150" /> <!-- plate-vertex servo radius -->
  <xacro:property name="servo_z"             value="-0.025" /> <!-- servo housing below plate -->
  <!-- True passive rest height: at shoulder 0 the elbow is at radius
       t+rf = 205 mm, the platform joint at pr = 60 mm, so the rod drop =
       sqrt(re^2 - (t+rf-pr)^2) = sqrt(0.320^2 - 0.145^2) = 0.2853 m. -->
  <xacro:property name="platform_z_rest"     value="-0.2853" />

  <!-- ======================================================================  -->
  <!-- MACROS                                                                  -->
  <!-- ======================================================================  -->

  <!-- Small box marking one actuation joint on the base plate. -->
  <xacro:macro name="joint_box" params="prefix px py">
    <visual name="motor_${prefix}">
      <pose>${px} ${py} 0 0 0 0</pose>
      <geometry>
        <box>
          <size>0.055 0.055 0.055</size>
        </box>
      </geometry>
      <material>
        <ambient>0.25 0.3 0.6 1</ambient>
        <diffuse>0.25 0.3 0.6 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <!-- Servo housing (visual only) hanging under the base plate at the plate
       vertex. servo_z < 0 puts the horn plane below the plate, matching the
       2-D visualiser's under-plate servos. -->
  <xacro:macro name="servo_housing" params="prefix px py yaw">
    <visual name="servo_${prefix}">
      <pose>${px} ${py} ${servo_z - 0.015} 0 0 ${yaw}</pose>
      <geometry>
        <box>
          <size>0.06 0.06 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0.45 0.42 0.38 1</ambient>
        <diffuse>0.45 0.42 0.38 1</diffuse>
      </material>
    </visual>
    <visual name="servo_horn_${prefix}">
      <pose>${px} ${py} ${servo_z - 0.01} 0 0 ${yaw}</pose>
      <geometry>
        <box>
          <size>0.055 0.012 0.008</size>
        </box>
      </geometry>
      <material>
        <ambient>0.62 0.62 0.68 1</ambient>
        <diffuse>0.62 0.62 0.68 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <!-- One delta leg: an identical limb subtree built in its own "mount" frame
       (a fixed joint rotating the limb plane by yaw around the centre axis).
       The shoulder joint axis is +X of the mount frame; at joint angle 0 the
       upper arm points outward horizontally and a positive angle swings the
       arm downward (matches the FK angle convention). -->
  <xacro:macro name="delta_leg" params="prefix px py yaw">
    <link name="mount_${prefix}">
      <pose>${px} ${py} 0 0 0 ${yaw}</pose>
    </link>
    <joint name="mount_${prefix}_fixed" type="fixed">
      <parent>base_link</parent>
      <child>mount_${prefix}</child>
    </joint>

    <joint name="shoulder_${prefix}" type="revolute">
      <parent>mount_${prefix}</parent>
      <child>upper_arm_${prefix}</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.2</lower>
          <upper>1.2</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="upper_arm_${prefix}">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <pose>0 ${-upper_arm_len / 2} 0 0 0 0</pose>
        <inertia>
          <ixx>5e-4</ixx>
          <iyy>5e-4</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="upper_arm_${prefix}_vis">
        <pose>0 ${-upper_arm_len / 2} 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>${upper_arm_len}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.6 0.15 1</ambient>
          <diffuse>0.8 0.6 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="upper_arm_${prefix}_col">
        <pose>0 ${-upper_arm_len / 2} 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>${upper_arm_len}</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="elbow_${prefix}" type="ball">
      <parent>upper_arm_${prefix}</parent>
      <child>rod_${prefix}</child>
      <pose>0 ${-upper_arm_len} 0 0 0 0</pose>
    </joint>

    <link name="rod_${prefix}">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <pose>0 0 ${rod_len / 2} 0 0 0</pose>
        <inertia>
          <ixx>3e-3</ixx>
          <iyy>3e-3</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rod_${prefix}_vis">
        <pose>0 -0.11 -0.152 2.8239 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>${rod_len}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.7 0.72 0.75 1</ambient>
          <diffuse>0.7 0.72 0.75 1</diffuse>
        </material>
      </visual>
      <collision name="rod_${prefix}_col">
        <pose>0 -0.11 -0.152 2.8239 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>${rod_len}</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="wrist_${prefix}" type="ball">
      <parent>rod_${prefix}</parent>
      <child>platform</child>
      <pose>0 0 ${rod_len} 0 0 0</pose>
    </joint>
  </xacro:macro>

  <world name="delta_arm_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <precon_iters>0</precon_iters>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.35 0.38 0.45 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Raised so the arm hangs in open space above the ground plane. -->
    <model name="delta_arm">
      <pose>0 0 0.9 0 0 0</pose>

      <!-- ==================================================================  -->
      <!-- BASE                                                               -->
      <!-- ==================================================================  -->
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>3.0</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="base_plate">
          <pose>0 0 0.0125 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.17</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="base_plate_col">
          <pose>0 0 0.0125 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.17</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
        </collision>
        <!-- Central column (visual only). -->
        <visual name="base_column">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.4 1</ambient>
            <diffuse>0.35 0.35 0.4 1</diffuse>
          </material>
        </visual>

        <!-- Motor boxes at the three actuation joints (radius t = 45 mm). -->
        <xacro:joint_box prefix="0" px="0" py="-0.045" />
        <xacro:joint_box prefix="1" px="0.03897" py="0.0225" />
        <xacro:joint_box prefix="2" px="-0.03897" py="0.0225" />

        <!-- Servo housings UNDER the plate at the plate-vertex radius. -->
        <xacro:servo_housing prefix="0" px="0" py="-0.15" yaw="-1.5708" />
        <xacro:servo_housing prefix="1" px="0.12990" py="0.075" yaw="0.5236" />
        <xacro:servo_housing prefix="2" px="-0.12990" py="0.075" yaw="2.6180" />
      </link>

      <joint name="base_to_world" type="fixed">
        <parent>world</parent>
        <child>base_link</child>
      </joint>

      <!-- ==================================================================  -->
      <!-- THREE DELTA LEGS (identical subtree in each rotated mount frame)     -->
      <!-- ==================================================================  -->
      <xacro:delta_leg prefix="0" px="0" py="-0.045" yaw="0" />
      <xacro:delta_leg prefix="1" px="0.03897" py="0.0225" yaw="2.0944" />
      <xacro:delta_leg prefix="2" px="-0.03897" py="0.0225" yaw="4.1888" />

      <!-- ==================================================================  -->
      <!-- PLATFORM (end-effector)                                             -->
      <!-- ==================================================================  -->
      <link name="platform">
        <pose>0 0 ${platform_z_rest} 0 0 0</pose>
        <inertial>
          <mass>0.4</mass>
          <pose>0 0 -0.0075 0 0 0</pose>
          <inertia>
            <ixx>4e-4</ixx>
            <iyy>4e-4</iyy>
            <izz>7e-4</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="platform_vis">
          <pose>0 0 -0.0075 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${ee_radius}</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.55 0.3 1</ambient>
            <diffuse>0.2 0.55 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="platform_col">
          <pose>0 0 -0.0075 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${ee_radius}</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="effector_marker">
          <pose>0 0 -0.02 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.01</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.9 0.3 0.25 1</ambient>
            <diffuse>0.9 0.3 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Stream the simulated joint angles (rad) for verification. -->
      <plugin name="joint_state_pub" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <remapping>joint_states:=gazebo/joint_states</remapping>
        </ros>
        <joint_name>shoulder_0</joint_name>
        <joint_name>shoulder_1</joint_name>
        <joint_name>shoulder_2</joint_name>
        <update_rate>30</update_rate>
      </plugin>

      <!-- ==================================================================  -->
      <!-- SIM PLUGIN - subscribes to arm/motor_targets (degrees) and servoes   -->
      <!-- the three shoulder joints.                                           -->
      <!-- ==================================================================  -->
      <plugin name="delta_arm_controller" filename="libdelta_arm_gazebo_plugin.so">
        <ros>
          <node_name>delta_arm_gazebo</node_name>
        </ros>
        <shoulder_0>shoulder_0</shoulder_0>
        <shoulder_1>shoulder_1</shoulder_1>
        <shoulder_2>shoulder_2</shoulder_2>
        <kp>25.0</kp>
        <ki>8.0</ki>
        <kd>1.2</kd>
        <tau_max>15.0</tau_max>
      </plugin>
    </model>
  </world>
</sdf>