<?xml version="1.0"?>
<!--
  Manual (WASD) control of the my arm.

  Launches the arm controller together with the manual-control node, which
  publishes set_pos action goals from WASD keys and prints current-position
  changes (get_pos stream).

  By default the controller runs in simulation mode (no motor driver) - set
  simulation:=false to use the real hardware (controller + driver in-process).

  Usage:
    ros2 launch arm_bringup manual.launch                     (simulation)
    ros2 launch arm_bringup manual.launch simulation:=false   (real hardware)
-->
<launch>
  <arg name="simulation" default="true"/>
  <arg name="params_file"
       default="$(find-pkg-share arm_bringup)/config/arm_params.yaml"/>

  <!-- Controller: real hardware = system (controller+driver); sim = controller only. -->
  <node pkg="arm_hardware" exec="arm_system" name="arm_system"
        output="screen" unless="$(var simulation)">
    <param from="$(var params_file)"/>
  </node>
  <node pkg="arm_hardware" exec="arm_controller" name="arm_controller"
        output="screen" if="$(var simulation)">
    <param from="$(var params_file)"/>
  </node>

  <!-- Manual-control node: sends set_pos goals from WASD, prints pos changes. -->
  <node pkg="arm_hardware" exec="arm_manual" name="arm_manual_control"
        output="screen">
    <param from="$(var params_file)"/>
  </node>
</launch>