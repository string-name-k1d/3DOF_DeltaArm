<?xml version="1.0"?>
<!--
  Gazebo simulation of the 3DOF delta arm.

  Launches the arm controller (simulation mode - no motor driver) together
  with the arm_sim_gazebo node, which stands in for the real mechanism and
  publishes the simulated end-effector pose / joint angles.

  Usage:
    ros2 launch arm_gazebo arm_gazebo.launch
-->
<launch>
  <arg name="params_file"
       default="$(find-pkg-share arm)/config/arm_params.yaml"/>

  <!-- Controller: task-space set_pos action + get_pos stream (no driver). -->
  <node pkg="arm" exec="arm_controller" name="arm_controller"
        output="screen">
    <param from="$(var params_file)"/>
  </node>

  <!-- Gazebo 3D delta-arm simulator. -->
  <node pkg="arm_gazebo" exec="arm_sim_gazebo" name="arm_sim_gazebo"
        output="screen"/>
</launch>
