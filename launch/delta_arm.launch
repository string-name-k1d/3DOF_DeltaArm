<?xml version="1.0"?>
<!--
  Delta-arm launch.

  Modes:
    * Full hardware (default):   motion:=true launches the controller and the
      motor driver as separate processes. set_pos goals drive the real servos.
    * Feedback-only hardware:    motion:=false launches both nodes with motion
      DISABLED (no set_pos action, no arm/motor_targets subscription) so servo
      feedback can be read without moving anything.
    * Simulation:                simulation:=true launches ONLY the controller.
      The arm simulation is provided externally (e.g. arm_gazebo or the SFML
      visualiser).

  Usage:
    ros2 launch arm delta_arm.launch                            (full hardware)
    ros2 launch arm delta_arm.launch motion:=false               (feedback only)
    ros2 launch arm delta_arm.launch simulation:=true            (simulation)
-->
<launch>
  <arg name="simulation" default="false"/>
  <arg name="motion" default="true"/>
  <arg name="params_file"
       default="$(find-pkg-share arm)/config/arm_params.yaml"/>
  <arg name="feedback_only_file"
       default="$(find-pkg-share arm)/config/arm_feedback_only.yaml"/>

  <!-- Motion enabled: the params file alone is enough. -->
  <group if="$(var motion)">
    <node pkg="arm" exec="arm_controller" name="arm_controller" output="screen">
      <param from="$(var params_file)"/>
    </node>
    <node pkg="arm" exec="arm_motor_driver" name="arm_motor_driver" output="screen"
          unless="$(var simulation)">
      <param from="$(var params_file)"/>
    </node>
  </group>

  <!-- Feedback-only: load the node-specific override AFTER the params file so
       enable_motion=false wins (an inline /**: wildcard would lose). -->
  <group unless="$(var motion)">
    <node pkg="arm" exec="arm_controller" name="arm_controller" output="screen">
      <param from="$(var params_file)"/>
      <param from="$(var feedback_only_file)"/>
    </node>
    <node pkg="arm" exec="arm_motor_driver" name="arm_motor_driver" output="screen"
          unless="$(var simulation)">
      <param from="$(var params_file)"/>
      <param from="$(var feedback_only_file)"/>
    </node>
  </group>
</launch>
