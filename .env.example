# Per-machine settings for the arm package.
#
#   cp .env.example .env     # then edit .env; it is gitignored
#
# Precedence: shell environment > .env > script/repo defaults.
# Keep one KEY=value per line; put comments on their own line (both
# run_arm.sh and Docker Compose read this file, but their parsing differs).
#
# This file is read by:
#   * scripts/build.sh   (build flags, workspace discovery)
#   * run_arm.sh         (runtime launch defaults)
#   * docker compose     (variable substitution, automatically)

# ROS 2 distribution to source when it is not already active.
ROS_DISTRO=humble

# Workspace root containing src/. Usually auto-detected by scripts/build.sh;
# set this only when the package is not under <workspace>/src/.
# ARM_WS=/home/k1d/arm_ws

# Build the optional 2-D SFML visualiser: ON to build arm_sim_sfml, OFF to
# skip it. Only honoured through scripts/build.sh (plain colcon ignores it).
ARM_BUILD_SFML_SIM=ON

# Packages passed to `colcon build --packages-select`. Defaults to arm.
# Add arm_gazebo when the 3-D simulator is built as a sibling package.
# ARM_BUILD_PACKAGES=arm arm_gazebo

# Optional alternate ROS parameter set.
# ARM_PARAMS_FILE=/home/k1d/arm_ws/src/fyp/arm/config/arm_gen0_params.yaml

# Serial adapter used by Docker Compose / scripts/launch_container.sh.
# Native runs take arm_motor_driver.port_name from config/arm_params.yaml.
SERIAL_DEVICE=/dev/ttyUSB0

# X11: normally inherited from the live desktop session. Set these only when
# the session values are wrong (for example over SSH or in a container).
# DISPLAY=:0
# XAUTHORITY=/home/k1d/.Xauthority
