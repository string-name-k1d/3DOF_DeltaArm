<?xml version="1.0"?>
<!--
  Manual (WASD + Z/X) control of the delta arm.

  Launches the arm controller together with the manual-control node, which
  publishes set_pos action goals from WASD / Z-X keys and prints current-position
  changes (get_pos stream).

  By default the controller runs in simulation mode (no motor driver) - set
  simulation:=false to use the real hardware (controller + driver in-process).

  Usage:
    ros2 launch arm manual.launch                     (simulation)
    ros2 launch arm manual.launch simulation:=false   (real hardware)
-->
<launch>
  <arg name="simulation" default="true"/>
  <!-- endpoint: start the standalone terminal end-effector node in SIMULATION.
       Hardware runs arm_system, which already embeds the endpoint node, so the
       standalone node is only started alongside the sim-only arm_controller. -->
  <arg name="endpoint" default="true"/>
  <arg name="params_file"
       default="$(find-pkg-share arm)/config/arm_params.yaml"/>

  <!-- Controller: real hardware = system (controller+driver+endpoint);
       sim = controller only. No name= on arm_system: it hosts three nodes and
       launch name= would inject a process-wide __node:= remap over all of them. -->
  <node pkg="arm" exec="arm_system"
        output="screen" unless="$(var simulation)">
    <param from="$(var params_file)"/>
  </node>
  <node pkg="arm" exec="arm_controller" name="arm_controller"
        output="screen" if="$(var simulation)">
    <param from="$(var params_file)"/>
  </node>

  <!-- Simulation-only standalone endpoint (hardware gets it from arm_system). -->
  <group if="$(var simulation)">
    <node pkg="arm" exec="arm_endpoint" name="arm_endpoint" output="screen"
          if="$(var endpoint)">
      <param from="$(var params_file)"/>
    </node>
  </group>

  <!-- Manual-control node: sends set_pos goals from WASD/Z-X, prints pos changes. -->
  <node pkg="arm" exec="arm_manual" name="arm_manual_control"
        output="screen">
    <param from="$(var params_file)"/>
  </node>
</launch>
