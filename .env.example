# Per-machine configuration for the arm package.
#
#   cp .env.example .env    # once, then edit for this machine
#   source .env             # load it in every shell that runs the scripts
#
# Docker Compose reads this file automatically as well.

# ROS 2 installation to source.
export ROS_DISTRO=humble

# Workspace root containing src/. Auto-detected when the package sits under
# <workspace>/src/; set it only for an unusual layout.
# export ARM_WS=$HOME/arm_ws

# Build options used by ./scripts/setup.sh.
export ARM_BUILD_SFML_SIM=ON
export ARM_BUILD_PACKAGES=arm
# export ARM_BUILD_PACKAGES="arm arm_gazebo"

# Optional alternate ROS parameter set for run_arm.sh.
# export ARM_PARAMS_FILE=$HOME/arm_ws/src/fyp/arm/config/arm_gen0_params.yaml

# Local tmux session name used by scripts/start_arm_tmux.sh (default: arm).
# This is a launcher setting only: the arm processes source this .env on the
# machine that owns the hardware.
# export ARM_TMUX_SESSION=arm

# Optional add-ons installed by ./scripts/setup.sh (1 = install).
export ARM_INSTALL_GAZEBO=0
export ARM_INSTALL_ROSBRIDGE=0

# Serial adapter for the arm servo bus (arm_motor_driver.port_name). Used by
# native runs and by Docker Compose / scripts/launch_container.sh.
export SERIAL_DEVICE=/dev/ttyUSB0

# X11: normally inherited from the live session. Set these only when the
# session values are wrong (for example over SSH or in a container).
# export DISPLAY=:0
# export XAUTHORITY=$HOME/.Xauthority
